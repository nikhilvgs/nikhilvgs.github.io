---
const year = new Date().getFullYear();

// TODO: replace with your real handles, or delete the ones you don't want.
const links = [
  { label: 'GitHub', href: 'https://github.com/nikhilvgs' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/YOUR-HANDLE' },
  { label: 'Google Scholar', href: 'https://scholar.google.com/citations?user=YOUR-ID' },
  { label: 'RSS', href: '/rss.xml' },
];
---

<footer class="colophon">
  <div class="shell">
    <div class="colophon__links">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </div>
    <p>
      &copy; {year} Nikhil Shetty. Everything here is written in a personal
      capacity and does not represent the views of my employer.
    </p>
  </div>
</footer>
