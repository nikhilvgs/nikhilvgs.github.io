---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
}

const { title, description, pubDate, updatedDate } = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title={`${title} — Nikhil Shetty`} description={description}>
  <article>
    <header>
      <time class="post__date" datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
      <h1 class="post__title">{title}</h1>
      <p class="post__standfirst">{description}</p>
    </header>
    <div class="prose">
      <slot />
      {updatedDate && <p class="post__date">Updated {fmt(updatedDate)}</p>}
    </div>
  </article>
</Base>
